<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <meta name="theme-color" content="#0f172a">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>AI Object Remover</title>
    <style>
        :root { --bg: #0f172a; --card: #1e293b; --text: #f8fafc; --muted: #94a3b8; --primary: #8b5cf6; --border: #334155; }
        * { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
        body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; padding: 20px; display: flex; flex-direction: column; align-items: center; }
        
        .header { text-align: center; margin-bottom: 20px; }
        .header h1 { font-size: 1.6em; background: linear-gradient(135deg, #8b5cf6, #ec4899); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .header p { color: var(--muted); font-size: 0.85em; margin-top: 5px; }

        .card { background: var(--card); border: 1px solid var(--border); border-radius: 16px; padding: 20px; width: 100%; max-width: 500px; margin-bottom: 15px; }

        /* Canvas Container */
        .canvas-container { 
            position: relative; 
            width: 100%; 
            aspect-ratio: 1/1; 
            background: #000; 
            border-radius: 12px; 
            overflow: hidden; 
            cursor: crosshair;
            touch-action: none;
        }
        canvas { position: absolute; top: 0; left: 0; width: 100%; height: 100%; }
        #imgCanvas { z-index: 1; }
        #maskCanvas { z-index: 2; }
        
        .placeholder { 
            position: absolute; top: 0; left: 0; width: 100%; height: 100%; 
            display: flex; flex-direction: column; align-items: center; justify-content: center; 
            color: var(--muted); pointer-events: none; z-index: 0;
        }

        /* Controls */
        .controls { display: flex; gap: 10px; margin-top: 15px; flex-wrap: wrap; }
        .control-group { flex: 1; min-width: 120px; }
        label { display: block; font-size: 0.8em; color: var(--muted); margin-bottom: 5px; }
        
        input[type="range"] { width: 100%; accent-color: var(--primary); }
        input[type="password"], input[type="file"] { 
            width: 100%; padding: 10px; background: var(--bg); border: 1px solid var(--border); 
            border-radius: 8px; color: var(--text); font-size: 0.9em; 
        }
        input[type="file"] { display: none; }

        .btn { 
            width: 100%; padding: 14px; border: none; border-radius: 10px; 
            font-size: 1em; font-weight: 600; cursor: pointer; margin-top: 10px; 
            transition: opacity 0.2s;
        }
        .btn-primary { background: linear-gradient(135deg, var(--primary), #ec4899); color: white; }
        .btn-secondary { background: var(--border); color: var(--text); }
        .btn:disabled { opacity: 0.5; cursor: not-allowed; }

        .brush-preview { 
            width: 20px; height: 20px; border-radius: 50%; background: rgba(239, 68, 68, 0.5); 
            border: 2px solid #ef4444; position: fixed; pointer-events: none; z-index: 100; 
            transform: translate(-50%, -50%); display: none;
        }

        .result-area { display: none; text-align: center; }
        .result-area img { width: 100%; border-radius: 12px; margin-bottom: 10px; }
        
        .loader { display: none; text-align: center; padding: 20px; }
        .loader.active { display: block; }
        .spinner { 
            width: 30px; height: 30px; border: 3px solid var(--border); border-top-color: var(--primary); 
            border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 10px; 
        }
        @keyframes spin { to { transform: rotate(360deg); } }

        .alert { 
            padding: 10px; border-radius: 8px; font-size: 0.85em; margin-top: 10px; display: none; 
        }
        .alert.error { display: block; background: rgba(239, 68, 68, 0.15); color: #fca5a5; }
        .alert.info { display: block; background: rgba(139, 92, 246, 0.15); color: #c4b5fd; }
    </style>
</head>
<body>

    <div class="header">
        <h1>✨ AI Object Remover</h1>
        <p>Закрась объект красной кистью → Удали его</p>
    </div>

    <div class="card">
        <div class="canvas-container" id="canvasContainer">
            <div class="placeholder" id="placeholder">
                <div style="font-size: 2em; margin-bottom: 10px;">🖼️</div>
                <div>Нажми, чтобы загрузить фото</div>
            </div>
            <canvas id="imgCanvas"></canvas>
            <canvas id="maskCanvas"></canvas>
        </div>
        <input type="file" id="fileInput" accept="image/*">

        <div class="controls">
            <div class="control-group">
                <label>Размер кисти: <span id="brushSizeVal">20</span>px</label>
                <input type="range" id="brushSize" min="5" max="100" value="20">
            </div>
            <div class="control-group">
                <button class="btn btn-secondary" onclick="clearMask()" style="margin-top: 22px;">🗑️ Очистить маску</button>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="input-group" style="margin-bottom: 10px;">
            <label>🔑 Hugging Face Token (Read)</label>
            <input type="password" id="apiKey" placeholder="hf_...">
        </div>
        <button class="btn btn-primary" id="removeBtn" onclick="removeObject()" disabled>🪄 Удалить объект</button>
        
        <div class="loader" id="loader">
            <div class="spinner"></div>
            <div style="font-size: 0.9em; color: var(--muted);">Нейросеть удаляет объект...<br>Это займет 10-30 секунд</div>
        </div>
        <div class="alert" id="alertBox"></div>
    </div>

    <div class="card result-area" id="resultArea">
        <h3 style="margin-bottom: 10px;">✅ Готово!</h3>
        <img id="resultImage">
        <a id="downloadLink" class="btn btn-primary" style="display:block; text-decoration:none; text-align:center;">💾 Сохранить результат</a>
        <button class="btn btn-secondary" onclick="resetApp()" style="margin-top: 10px;">🔄 Начать заново</button>
    </div>

    <div class="brush-preview" id="brushPreview"></div>

    <script>
        // Элементы
        const fileInput = document.getElementById('fileInput');
        const placeholder = document.getElementById('placeholder');
        const imgCanvas = document.getElementById('imgCanvas');
        const maskCanvas = document.getElementById('maskCanvas');
        const ctxImg = imgCanvas.getContext('2d');
        const ctxMask = maskCanvas.getContext('2d');
        const brushSizeInput = document.getElementById('brushSize');
        const brushSizeVal = document.getElementById('brushSizeVal');
        const brushPreview = document.getElementById('brushPreview');
        const container = document.getElementById('canvasContainer');
        const removeBtn = document.getElementById('removeBtn');
        const loader = document.getElementById('loader');
        const alertBox = document.getElementById('alertBox');
        const resultArea = document.getElementById('resultArea');
        const resultImage = document.getElementById('resultImage');
        const downloadLink = document.getElementById('downloadLink');

        let isDrawing = false;
        let hasImage = false;
        let currentBrushSize = 20;

        // Загрузка токена
        const savedToken = localStorage.getItem('hf_token');
        if (savedToken) document.getElementById('apiKey').value = savedToken;

        // Клик по контейнеру для загрузки
        container.addEventListener('click', (e) => {
            if (!hasImage && e.target === container || e.target === placeholder) {
                fileInput.click();
            }
        });

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (!file) return;
            
            const img = new Image();
            img.onload = () => {
                // Масштабируем под контейнер
                const rect = container.getBoundingClientRect();
                const scale = Math.min(rect.width / img.width, rect.height / img.height);
                const w = img.width * scale;
                const h = img.height * scale;
                
                imgCanvas.width = w; maskCanvas.width = w;
                imgCanvas.height = h; maskCanvas.height = h;
                
                ctxImg.drawImage(img, 0, 0, w, h);
                clearMask();
                
                hasImage = true;
                placeholder.style.display = 'none';
                removeBtn.disabled = false;
            };
            img.src = URL.createObjectURL(file);
        });

        // Рисование маски
        function getPos(e) {
            const rect = maskCanvas.getBoundingClientRect();
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            return {
                x: (clientX - rect.left) * (maskCanvas.width / rect.width),
                y: (clientY - rect.top) * (maskCanvas.height / rect.height)
            };
        }

        function startDraw(e) {
            if (!hasImage) return;
            isDrawing = true;
            draw(e);
        }

        function endDraw() { isDrawing = false; }

        function draw(e) {
            if (!isDrawing || !hasImage) return;
            e.preventDefault(); // Блокируем скролл на тачскринах
            
            const pos = getPos(e);
            ctxMask.fillStyle = 'rgba(255, 0, 0, 0.5)';
            ctxMask.beginPath();
            ctxMask.arc(pos.x, pos.y, currentBrushSize / 2, 0, Math.PI * 2);
            ctxMask.fill();
        }

        // События мыши/тача
        maskCanvas.addEventListener('mousedown', startDraw);
        maskCanvas.addEventListener('mousemove', (e) => { draw(e); updateBrushPreview(e); });
        maskCanvas.addEventListener('mouseup', endDraw);
        maskCanvas.addEventListener('mouseleave', endDraw);
        
        maskCanvas.addEventListener('touchstart', startDraw, {passive: false});
        maskCanvas.addEventListener('touchmove', (e) => { draw(e); updateBrushPreview(e); }, {passive: false});
        maskCanvas.addEventListener('touchend', endDraw);

        // Превью кисти
        function updateBrushPreview(e) {
            const clientX = e.touches ? e.touches[0].clientX : e.clientX;
            const clientY = e.touches ? e.touches[0].clientY : e.clientY;
            brushPreview.style.left = clientX + 'px';
            brushPreview.style.top = clientY + 'px';
            brushPreview.style.width = currentBrushSize + 'px';
            brushPreview.style.height = currentBrushSize + 'px';
            brushPreview.style.display = 'block';
        }
        container.addEventListener('mouseleave', () => brushPreview.style.display = 'none');

        // Управление кистью
        brushSizeInput.addEventListener('input', (e) => {
            currentBrushSize = e.target.value;
            brushSizeVal.textContent = currentBrushSize;
        });

        function clearMask() {
            ctxMask.clearRect(0, 0, maskCanvas.width, maskCanvas.height);
        }

        // Отправка на API
        async function removeObject() {
            const apiKey = document.getElementById('apiKey').value.trim();
            if (!apiKey.startsWith('hf_')) {
                showAlert('Введи корректный токен (начинается с hf_)', 'error');
                return;
            }
            localStorage.setItem('hf_token', apiKey);

            // Проверяем, есть ли маска
            const pixelData = ctxMask.getImageData(0, 0, maskCanvas.width, maskCanvas.height).data;
            let hasMask = false;
            for (let i = 0; i < pixelData.length; i += 4) {
                if (pixelData[i] > 0) { hasMask = true; break; } // Красный канал
            }
            if (!hasMask) {
                showAlert('Сначала закрась объект красной кистью!', 'error');
                return;
            }

            removeBtn.disabled = true;
            loader.classList.add('active');
            resultArea.style.display = 'none';
            hideAlert();

            try {
                // Конвертируем канвасы в Blob
                const imageBlob = await new Promise(r => imgCanvas.toBlob(r, 'image/png'));
                const maskBlob = await new Promise(r => maskCanvas.toBlob(r, 'image/png'));

                const formData = new FormData();
                formData.append('image', imageBlob);
                formData.append('mask_image', maskBlob);

                // Используем LaMa через прокси для обхода CORS
                const response = await fetch('https://corsproxy.io/?' + encodeURIComponent('https://api-inference.huggingface.co/models/fffiloni/lama'), {
                    method: 'POST',
                    headers: { 'Authorization': `Bearer ${apiKey}` },
                    body: formData
                });

                if (!response.ok) {
                    if (response.status === 503) throw new Error('Модель загружается. Подожди 30с и повтори.');
                    if (response.status === 401) throw new Error('Неверный токен.');
                    throw new Error(`Ошибка API: ${response.status}`);
                }

                const blob = await response.blob();
                const url = URL.createObjectURL(blob);
                
                resultImage.src = url;
                downloadLink.href = url;
                downloadLink.download = `cleaned-${Date.now()}.png`;
                
                loader.classList.remove('active');
                resultArea.style.display = 'block';
                resultArea.scrollIntoView({behavior: 'smooth'});

            } catch (err) {
                loader.classList.remove('active');
                showAlert(err.message, 'error');
            } finally {
                removeBtn.disabled = false;
            }
        }

        function resetApp() {
            resultArea.style.display = 'none';
            clearMask();
            window.scrollTo({top: 0, behavior: 'smooth'});
        }

        function showAlert(msg, type) {
            alertBox.textContent = msg;
            alertBox.className = `alert ${type}`;
        }
        function hideAlert() { alertBox.className = 'alert'; }
    </script>
</body>
</html>
